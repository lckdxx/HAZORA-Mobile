<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2000000">

    <com.hazora.app.ui.hazardscan.ZoomableImageView
        android:id="@+id/iv_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Full screen captured image" />

    <TextView
        android:id="@+id/btn_close_fullscreen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="✕"
        android:textColor="@android:color/white"
        android:textSize="26sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Pinch or double-tap to zoom"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

</FrameLayout>
