<resources>
    <style name="Base.Theme.HAZORA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Force light colors even in night mode to match Figma instructions -->
        <item name="colorPrimary">@color/hazora_primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/hazora_primary_blue</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/hazora_accent_orange</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/hazora_text_primary</item>
        <item name="android:windowBackground">@color/hazora_background_light</item>

        <item name="android:statusBarColor">@color/hazora_primary_blue</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.HAZORA" parent="Base.Theme.HAZORA" />
    <style name="Theme.HAZORA.Light" parent="Theme.HAZORA" />
</resources>
