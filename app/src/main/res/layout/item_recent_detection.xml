<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/dashboard_surface"
    app:cardCornerRadius="@dimen/dashboard_card_radius"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/img_detection_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_hard_hat"
            app:tint="#E55353"
            android:background="@drawable/bg_circle_light_red"
            android:padding="12dp"
            android:contentDescription="Detection Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tv_detection_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safety Violation"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/dashboard_text_primary" />

            <TextView
                android:id="@+id/tv_detection_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAM-00 • 00:00 AM"
                android:textSize="12sp"
                android:textColor="@color/dashboard_text_muted"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_detection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New"
            android:background="@drawable/bg_dashboard_status_new"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/dashboard_status_new"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>