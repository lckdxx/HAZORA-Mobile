<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Optional Incident Image (Only visible if imageUrl exists in Firebase) -->
        <ImageView
            android:id="@+id/img_incident_photo"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Incident Photo" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Hazard Category Icon -->
            <ImageView
                android:id="@+id/img_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_red_light"
                android:contentDescription="Incident Icon"
                android:padding="10dp"
                android:src="@drawable/ic_hard_hat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#EF4444" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="Missing Hard Hat Detected"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tv_status"
                app:layout_constraintStart_toEndOf="@id/img_icon"
                app:layout_constraintTop_toTopOf="@id/img_icon" />

            <!-- Date & Time -->
            <TextView
                android:id="@+id/tv_camera_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Jun 30, 2026 • 09:14 AM"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/tv_status"
                app:layout_constraintStart_toStartOf="@id/tv_title"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />

            <!-- Status Badge (Top Right) -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_red_light"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="New"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Severity Badge (Below Status on Right) -->
            <LinearLayout
                android:id="@+id/layout_severity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_severity_critical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_status">

                <ImageView
                    android:id="@+id/img_severity_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:contentDescription="Dot"
                    android:src="@drawable/ic_dot_red" />

                <TextView
                    android:id="@+id/tv_severity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Critical"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Divider line before footer -->
            <View
                android:id="@+id/divider_footer"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#F1F5F9"
                app:layout_constraintTop_toBottomOf="@id/img_icon" />

            <!-- Footer: Camera and Location Site -->
            <LinearLayout
                android:id="@+id/layout_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/divider_footer">

                <!-- Camera -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Camera"
                    android:src="@drawable/ic_camera"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tv_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="CAM-04"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Space between -->
                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <!-- Location Pin -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Location"
                    app:drawableStartCompat="@drawable/ic_location"
                    android:src="@drawable/ic_location"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tv_site"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Zone B — Scaffold Level 3"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
