<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:src="@drawable/hazora_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Welcome to HAZORA"
            android:textColor="@color/hazora_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Your AI Safety Companion"
            android:textColor="@color/hazora_primary_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="20dp"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Major Functions"
                    android:textColor="@color/hazora_text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• AI Hazard Scan: Detects PPE in any lighting.\n\n• SOS Alert: Fast emergency signaling.\n\n• Chat: Real-time messaging and photo sharing."
                    android:textColor="@color/hazora_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Minor Functions"
                    android:textColor="@color/hazora_text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Recent Feed: Last 3 scans at a glance.\n\n• Profile: Quick name or password updates.\n\n• Incidents: View full hazard logs."
                    android:textColor="@color/hazora_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_circle_light_blue"
                    android:padding="12dp"
                    android:text="💡 Tip: Hold the phone steady for 1 second during AI scans for better results!"
                    android:textColor="@color/hazora_primary_blue"
                    android:textSize="13sp"
                    android:textStyle="italic" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip_guide"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Skip"
                android:textColor="@color/hazora_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_continue_guide"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="2"
                android:text="Get Started"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/hazora_primary_blue" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
