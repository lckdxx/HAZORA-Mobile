<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dashboard_header"
            android:minHeight="126dp">

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:contentDescription="Back"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:gravity="center"
                android:minWidth="36dp"
                android:minHeight="40dp" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Incident Title"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- Detail card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="@dimen/surface_card_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Card Title -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Missing Hard Hat Detected"
                    android:textColor="@color/primary_text_dark"
                    android:textStyle="bold"
                    android:textSize="22sp" />

                <!-- Status pill -->
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:minHeight="32dp"
                    android:text="NEW"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Sections -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Severity"
                        android:textColor="@color/dashboard_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_severity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="High"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="15sp"
                        android:background="@drawable/bg_detail_severity"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginTop="4dp" />

                    <View android:layout_width="match_parent" android:layout_height="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Camera"
                        android:textColor="@color/secondary_text_dark"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_camera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CAM-04"
                        android:textColor="@color/primary_text_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="4dp" />

                    <View android:layout_width="match_parent" android:layout_height="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detected"
                        android:textColor="@color/secondary_text_dark"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="09:14 AM"
                        android:textColor="@color/primary_text_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="4dp" />

                    <View android:layout_width="match_parent" android:layout_height="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textColor="@color/secondary_text_dark"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_site"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Construction Site A — Zone B"
                        android:textColor="@color/primary_text_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="4dp" />

                    <View android:layout_width="match_parent" android:layout_height="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textColor="@color/secondary_text_dark"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textColor="@color/primary_text_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Acknowledge button -->
                <Button
                    android:id="@+id/btn_acknowledge"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:text="Acknowledge Incident"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_primary_button"
                    android:backgroundTint="@null"
                    android:elevation="2dp"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
