<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Scrollable dashboard content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dashboard_horizontal_margin"
            android:paddingEnd="@dimen/dashboard_horizontal_margin"
            android:background="@color/background_light">

            <!-- Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_dashboard_header"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOOD MORNING"
                    android:textAllCaps="true"
                    android:textColor="#D2E2F7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_greeting"
                    app:layout_constraintEnd_toStartOf="@id/img_avatar"
                    app:layout_constraintHorizontal_bias="0" />

                <ImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerInside"
                    android:padding="11dp"
                    android:background="@drawable/circle_orange_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_name" />

                <TextView
                    android:id="@+id/tv_site_context"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Construction Site A - Zone B"
                    android:textColor="#C9DDF7"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/img_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_name" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Content area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <!-- Statistics row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="@dimen/surface_card_radius"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:src="@drawable/ic_warning"
                                android:background="@drawable/bg_circle_light_red"
                                android:padding="10dp"
                                android:tint="#E55353" />

                            <TextView
                                android:id="@+id/tv_active_hazards"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/dashboard_text_primary"
                                android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Active Hazards"
                                    android:gravity="center"
                                    android:maxLines="2"
                                android:textSize="12sp"
                                android:textColor="@color/dashboard_text_muted"
                                android:layout_marginTop="5dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="@dimen/surface_card_radius"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:src="@drawable/ic_pulse"
                                android:background="@drawable/bg_circle_light_orange"
                                android:padding="10dp"
                                android:tint="#F59E0B" />

                            <TextView
                                android:id="@+id/tv_total_incidents"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/dashboard_text_primary"
                                android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Today's Incidents"
                                    android:gravity="center"
                                    android:maxLines="2"
                                android:textSize="12sp"
                                android:textColor="@color/dashboard_text_muted"
                                android:layout_marginTop="5dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="136dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/surface_card_radius"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:src="@drawable/ic_check_circle"
                                android:background="@drawable/bg_circle_light_green"
                                android:padding="10dp"
                                android:tint="#35B66F" />

                            <TextView
                                android:id="@+id/tv_resolved_incidents"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/dashboard_text_primary"
                                android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Resolved Today"
                                    android:gravity="center"
                                    android:maxLines="2"
                                android:textSize="12sp"
                                android:textColor="@color/dashboard_text_muted"
                                android:layout_marginTop="5dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Quick Actions title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/dashboard_text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- AI Hazard Scan card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_ai_scan"
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="@dimen/surface_card_radius"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/dashboard_surface"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:background="@drawable/bg_login_sign_in">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_camera"
                            android:tint="@color/white"
                            android:background="@drawable/bg_circle_light_blue"
                            android:padding="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI Hazard Scan"
                                    android:textColor="@color/white"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEW"
                                    android:textColor="@color/white"
                                    android:background="@drawable/bg_badge_orange"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingBottom="3dp"
                                    android:textSize="10sp"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Capture &amp; analyze workplace hazards instantly"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:layout_marginTop="5dp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/white"
                            android:background="@drawable/bg_icon_blue_light"
                            android:padding="11dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Secondary actions row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="@dimen/surface_card_radius"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_surface"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_phone"
                                android:tint="#E55353"
                                android:background="@drawable/bg_circle_light_red"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SOS Emergency"
                                android:textSize="12sp"
                                android:textColor="#1A1A1A"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_messages"
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="@dimen/surface_card_radius"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_surface"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_chat"
                                android:tint="#6B46C1"
                                android:background="@drawable/bg_circle_light_purple"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Messages"
                                android:textSize="12sp"
                                android:textColor="#1A1A1A"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_incidents_list"
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/surface_card_radius"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_surface"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_clipboard"
                                android:tint="#244C97"
                                android:background="@drawable/bg_circle_light_blue"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Incidents"
                                android:textSize="12sp"
                                android:textColor="#1A1A1A"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Recent Detections header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Detections"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/dashboard_text_primary" />

                    <TextView
                        android:id="@+id/tv_see_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See All"
                        android:textSize="14sp"
                        android:textColor="@color/primary_blue" />

                </LinearLayout>

                <!-- Dynamic container for recent detections -->
                <LinearLayout
                    android:id="@+id/container_recent_detections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Navigation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:elevation="8dp"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/bottom_nav_color"
            app:itemTextColor="@color/bottom_nav_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

        <ImageView
            android:id="@+id/dashboard_camera_action_visual"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|center_horizontal"
            android:clickable="false"
            android:contentDescription="Camera"
            android:elevation="16dp"
            android:focusable="false"
            android:src="@drawable/ic_camera_floating"
            android:translationY="-20dp" />
    </FrameLayout>

</FrameLayout>
