<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:contentDescription="Back"
                android:textColor="@color/primary_text_dark"
                android:textSize="30sp"
                android:gravity="center"
                android:minWidth="36dp"
                android:minHeight="40dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Incidents"
                android:textColor="@color/primary_text_dark"
                android:textStyle="bold"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_delete_resolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete Resolved"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitor and review detected workplace hazards."
            android:textColor="@color/dashboard_text_muted"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Summary card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="@dimen/surface_card_radius"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        android:padding="16dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_alert"
                android:background="@drawable/bg_icon_red"
                android:tint="@color/danger"
                android:padding="9dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Incidents"
                    android:textColor="@color/dashboard_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_today_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/primary_text_dark"
                    android:textStyle="bold"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detected workplace safety incidents"
                    android:textColor="@color/dashboard_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/filters_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/filter_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="All"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_message_filter_selected"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/filter_new"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="New"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_message_filter_unselected"
                android:textColor="@color/primary_blue" />

            <TextView
                android:id="@+id/filter_ack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="Acknowledged"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_message_filter_unselected"
                android:textColor="@color/primary_blue" />

            <TextView
                android:id="@+id/filter_resolved"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="Resolved"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_message_filter_unselected"
                android:textColor="@color/primary_blue" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- RecyclerView / Empty state -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
            android:paddingTop="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_incidents"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_blue_light"
                android:contentDescription="No incidents"
                android:padding="14dp"
                android:src="@drawable/ic_alert"
                android:tint="@color/primary_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No incidents found"
                android:textColor="@color/primary_text_dark"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="There are no incidents in this category."
                android:textColor="@color/secondary_text_dark"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
